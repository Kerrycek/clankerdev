REPO=Kerrycek/clankerdev
REPO_URL=git@github.com:Kerrycek/clankerdev.git
BASE_BRANCH=main
WORKDIR=/srv/clankerdev-ai/worktree
STATE_DIR=/var/lib/clankerdev-ai
LOG_DIR=/var/log/clankerdev-ai
ISSUE_LABEL=ai-fix
IN_PROGRESS_LABEL=ai-in-progress
DONE_LABEL=ai-pr
FAILED_LABEL=ai-failed
# Optional: leave empty to use the Codex CLI default model.
CODEX_MODEL=
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL=never

# Exact GitHub logins and organization names; comma/space separated.
# Unknown membership and API failures are denied. Do not trust author_association.
TRUSTED_USERS=Kerrycek
TRUSTED_ORGS=vpsfreecz
POLICY_SCRIPT=/usr/local/lib/clankerdev-ai/issue-policy.mjs
# Inspect eligibility/approval hashes without GitHub writes or Codex calls.
RUNNER_DRY_RUN=0
