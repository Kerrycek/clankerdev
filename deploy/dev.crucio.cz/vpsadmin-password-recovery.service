[Unit]
Description=Process queued vpsAdmin password-recovery requests
Requires=vpsadmin-api.service vpsadmin-notification-templates.service
After=vpsadmin-api.service vpsadmin-notification-templates.service
ConditionPathExists=/srv/vpsadmin-release/current/api/bin/vpsadmin-password-recovery

[Service]
Type=simple
WorkingDirectory=/srv/vpsadmin-release/current/api
Environment=RACK_ENV=production
ExecStart=/bin/bash -lc 'exec /nix/var/nix/profiles/default/bin/nix --extra-experimental-features nix-command --extra-experimental-features flakes develop /srv/vpsadmin-release/current#api -c bundle exec bin/vpsadmin-password-recovery'
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
